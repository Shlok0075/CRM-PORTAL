generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  domain    String?  @unique
  logo      String?
  branding  String?
  settings  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                     User[]
  roles                     Role[]
  clients                   Client[]
  clientGroups              ClientGroup[]
  services                  Service[]
  packages                  Package[]
  retainers                 Retainer[]
  billingProfiles           BillingProfile[]
   tasks                     Task[]
   recurrenceRules           RecurrenceRule[]
   complianceCalendarEntries ComplianceCalendarEntry[]
   taskDocumentRequests      TaskDocumentRequest[]
   taskTimeLogs              TaskTimeLog[]
  invoices                  Invoice[]
  creditNotes               CreditNote[]
  receipts                  Receipt[]
  expenses                  Expense[]
  expenseCategories         ExpenseCategory[]
  quotations                Quotation[]
  documents                 Document[]
  documentInOutLogs         DocumentInOutLog[]
  messageTemplates          MessageTemplate[]
  messageLogs               MessageLog[]
  attendanceRecords         Attendance[]
  todos                     Todo[]
  notifications             Notification[]
  applications              Application[]
  startups                  Startup[]
  cohorts                   Cohort[]
}

model Role {
  id          String       @id @default(uuid())
  org         Organization @relation(fields: [orgId], references: [id])
  orgId       String
  name        String
  permissions String
  users       User[]
}

model User {
  id           String       @id @default(uuid())
  org          Organization @relation(fields: [orgId], references: [id])
  orgId        String
  email        String       @unique
  name         String?
  passwordHash String?
  phone        String?
  designation  String?
  isActive     Boolean      @default(true)
  role         Role?        @relation(fields: [roleId], references: [id])
  roleId       String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  clients           Client[]
  assignedTasks     Task[]         @relation("AssignedTasks")
  taskNotes         TaskNote[]
  taskTimeLogs      TaskTimeLog[]
  attendanceRecords Attendance[]
  todos             Todo[]
  notifications     Notification[]
  startupResponsibleFor Startup[]
  mentor            Mentor?
}

model Client {
  id                String       @id @default(uuid())
  org               Organization @relation(fields: [orgId], references: [id])
  orgId             String
  name              String
  pan               String?
  gstins            String
  type              String?
  groupId           String?
  group             ClientGroup? @relation(fields: [groupId], references: [id])
  contactInfo       String?
  customPricing     String?
  status            String       @default("active")
  responsibleUser   User?        @relation(fields: [responsibleUserId], references: [id])
  responsibleUserId String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  credentials          ClientCredential[]
  dscRecords           DscRecord[]
  retainers            Retainer[]
  tasks                Task[]
  taskDocumentRequests TaskDocumentRequest[]
  documents            Document[]
  documentInOutLogs    DocumentInOutLog[]
  invoices             Invoice[]
  receipts             Receipt[]
  expenses             Expense[]
  quotations           Quotation[]
  messageLogs          MessageLog[]
}

model ClientGroup {
  id        String       @id @default(uuid())
  org       Organization @relation(fields: [orgId], references: [id])
  orgId     String
  name      String
  createdAt DateTime     @default(now())

  clients Client[]
}

model ClientCredential {
  id                String   @id @default(uuid())
  client            Client   @relation(fields: [clientId], references: [id])
  clientId          String
  portalType        String
  username          String
  encryptedPassword String
  createdAt         DateTime @default(now())
}

model DscRecord {
  id               String   @id @default(uuid())
  client           Client   @relation(fields: [clientId], references: [id])
  clientId         String
  holderName       String
  dscClass         String?
  issuingAuthority String?
  expiryDate       DateTime
  custodyStatus    String?
  createdAt        DateTime @default(now())
}

model Service {
  id           String       @id @default(uuid())
  org          Organization @relation(fields: [orgId], references: [id])
  orgId        String
  name         String
  defaultPrice Float?
  createdAt    DateTime     @default(now())
}

model Package {
  id         String       @id @default(uuid())
  org        Organization @relation(fields: [orgId], references: [id])
  orgId      String
  name       String
  serviceIds String
  price      Float?
  createdAt  DateTime     @default(now())
}

model Retainer {
  id               String       @id @default(uuid())
  org              Organization @relation(fields: [orgId], references: [id])
  orgId            String
  client           Client       @relation(fields: [clientId], references: [id])
  clientId         String
  packageIds       String
  totalAmount      Float?
  billingFrequency String
  startDate        DateTime
  endDate          DateTime?
  autoRenew        Boolean      @default(false)
  status           String       @default("active")
  createdAt        DateTime     @default(now())
}

model BillingProfile {
  id        String       @id @default(uuid())
  org       Organization @relation(fields: [orgId], references: [id])
  orgId     String
  name      String
  clientIds String
  invoices  Invoice[]
  createdAt DateTime     @default(now())
}

model RecurrenceRule {
  id          String       @id @default(uuid())
  org         Organization @relation(fields: [orgId], references: [id])
  orgId       String
  frequency   String
  interval    Int          @default(1)
  nextRunDate DateTime?
  tasks       Task[]
}

model ComplianceCalendarEntry {
  id           String       @id @default(uuid())
  org          Organization @relation(fields: [orgId], references: [id])
  orgId        String
  name         String
  applicableTo String
  dueDateRule  String
  createdAt    DateTime     @default(now())
}

model Task {
  id               String          @id @default(uuid())
  org              Organization    @relation(fields: [orgId], references: [id])
  orgId            String
  client           Client?         @relation(fields: [clientId], references: [id])
  clientId         String?
  title            String
  description      String?
  status           String          @default("not_started")
  dueDate          DateTime?
  targetDate       DateTime?
  assigneeIds      String?
  tags             String
  reviewerId       String?
  recurrenceRuleId String?
  recurrenceRule   RecurrenceRule? @relation(fields: [recurrenceRuleId], references: [id])
  priority         String          @default("medium")
  serviceType      String?
  customFields     String?
  isOverdue        Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  assignee         User?                 @relation("AssignedTasks", fields: [assigneeIds], references: [id])
  checklistItems   TaskChecklistItem[]
  subtasks         TaskSubtask[]
  notes            TaskNote[]
  documentRequests TaskDocumentRequest[]
  timeLogs         TaskTimeLog[]
  documents        Document[]
}

model TaskChecklistItem {
  id     String  @id @default(uuid())
  task   Task    @relation(fields: [taskId], references: [id])
  taskId String
  label  String
  isDone Boolean @default(false)
  order  Int?
}

model TaskSubtask {
  id           String  @id @default(uuid())
  parentTask   Task    @relation(fields: [parentTaskId], references: [id])
  parentTaskId String
  title        String
  assigneeId   String?
  status       String  @default("not_started")
}

model TaskNote {
  id               String   @id @default(uuid())
  task             Task     @relation(fields: [taskId], references: [id])
  taskId           String
  author           User?    @relation(fields: [authorId], references: [id])
  authorId         String?
  body             String
  mentionedUserIds String
  createdAt        DateTime @default(now())
}

model TaskDocumentRequest {
  id                 String       @id @default(uuid())
  org                Organization @relation(fields: [orgId], references: [id])
  orgId              String
  task               Task         @relation(fields: [taskId], references: [id])
  taskId             String
  client             Client?      @relation(fields: [clientId], references: [id])
  clientId           String?
  documentName       String
  category           String?
  status             String       @default("pending")
  uploadedDocumentId String?
  createdAt          DateTime     @default(now())
  documents          Document[]
}

model TaskTimeLog {
  id              String       @id @default(uuid())
  org             Organization @relation(fields: [orgId], references: [id])
  orgId           String
  task            Task         @relation(fields: [taskId], references: [id])
  taskId          String
  user            User?        @relation(fields: [userId], references: [id])
  userId          String?
  startTime       DateTime
  endTime         DateTime?
  durationMinutes Int?
  description     String?
}

model Invoice {
  id               String          @id @default(uuid())
  org              Organization    @relation(fields: [orgId], references: [id])
  orgId            String
  client           Client?         @relation(fields: [clientId], references: [id])
  clientId         String?
  billingProfile   BillingProfile? @relation(fields: [billingProfileId], references: [id])
  billingProfileId String?
  invoiceNumber    String
  lineItems        String
  subtotal         Float?
  cgst             Float?
  sgst             Float?
  igst             Float?
  total            Float?
  status           String          @default("draft")
  issueDate        DateTime?
  dueDate          DateTime?
  hsnSac           String?
  placeOfSupply    String?
  createdAt        DateTime        @default(now())

  lineItemsList InvoiceLineItem[]
  creditNotes   CreditNote[]
  receipts      Receipt[]
}

model InvoiceLineItem {
  id          String  @id @default(uuid())
  invoice     Invoice @relation(fields: [invoiceId], references: [id])
  invoiceId   String
  description String
  quantity    Float?
  unitPrice   Float?
  amount      Float?
  hsnSac      String?
}

model CreditNote {
  id             String        @id @default(uuid())
  invoice        Invoice       @relation(fields: [invoiceId], references: [id])
  invoiceId      String
  amount         Float
  reason         String?
  createdAt      DateTime      @default(now())
  Organization   Organization? @relation(fields: [organizationId], references: [id])
  organizationId String?
}

model Receipt {
  id             String        @id @default(uuid())
  invoice        Invoice?      @relation(fields: [invoiceId], references: [id])
  invoiceId      String?
  client         Client?       @relation(fields: [clientId], references: [id])
  clientId       String?
  amount         Float
  mode           String
  date           DateTime?
  createdAt      DateTime      @default(now())
  Organization   Organization? @relation(fields: [organizationId], references: [id])
  organizationId String?
}

model Expense {
  id           String           @id @default(uuid())
  org          Organization     @relation(fields: [orgId], references: [id])
  orgId        String
  client       Client?          @relation(fields: [clientId], references: [id])
  clientId     String?
  category     ExpenseCategory? @relation(fields: [categoryId], references: [id])
  categoryId   String?
  amount       Float
  isBillable   Boolean          @default(false)
  description  String?
  date         DateTime?
  attachmentId String?
  createdAt    DateTime         @default(now())
}

model ExpenseCategory {
  id       String       @id @default(uuid())
  org      Organization @relation(fields: [orgId], references: [id])
  orgId    String
  name     String
  expenses Expense[]
}

model Quotation {
  id        String       @id @default(uuid())
  org       Organization @relation(fields: [orgId], references: [id])
  orgId     String
  client    Client?      @relation(fields: [clientId], references: [id])
  clientId  String?
  lineItems String
  status    String       @default("draft")
  createdAt DateTime     @default(now())
}

model Document {
  id                    String               @id @default(uuid())
  org                   Organization         @relation(fields: [orgId], references: [id])
  orgId                 String
  client                Client?              @relation(fields: [clientId], references: [id])
  clientId              String?
  task                  Task?                @relation(fields: [taskId], references: [id])
  taskId                String?
  taskDocumentRequest   TaskDocumentRequest? @relation(fields: [taskDocumentRequestId], references: [id])
  taskDocumentRequestId String?
  category              String
  fileUrl               String
  fileName              String?
  fileType              String?
  fileSize              Int?
  version               Int                  @default(1)
  uploadedBy            String?
  uploadedByType        String?
  isPublic              Boolean              @default(false)
  createdAt             DateTime             @default(now())
}

model DocumentInOutLog {
  id         String       @id @default(uuid())
  org        Organization @relation(fields: [orgId], references: [id])
  orgId      String
  client     Client?      @relation(fields: [clientId], references: [id])
  clientId   String?
  direction  String
  itemName   String
  status     String
  date       DateTime?
  location   String?
  returnable Boolean      @default(false)
  remarks    String?
  createdAt  DateTime     @default(now())
}

model MessageTemplate {
  id        String       @id @default(uuid())
  org       Organization @relation(fields: [orgId], references: [id])
  orgId     String
  channel   String
  name      String
  body      String
  createdAt DateTime     @default(now())
}

model MessageLog {
  id         String       @id @default(uuid())
  org        Organization @relation(fields: [orgId], references: [id])
  orgId      String
  client     Client?      @relation(fields: [clientId], references: [id])
  clientId   String?
  channel    String
  templateId String?
  status     String
  sentAt     DateTime?
  createdAt  DateTime     @default(now())
}

model Attendance {
  id        String       @id @default(uuid())
  org       Organization @relation(fields: [orgId], references: [id])
  orgId     String
  user      User         @relation(fields: [userId], references: [id])
  userId    String
  date      DateTime
  inTime    DateTime?
  outTime   DateTime?
  status    String
  createdAt DateTime     @default(now())

  @@unique([userId, date])
}

model Todo {
  id         String       @id @default(uuid())
  org        Organization @relation(fields: [orgId], references: [id])
  orgId      String
  assignee   User?        @relation(fields: [assigneeId], references: [id])
  assigneeId String?
  title      String
  dueDate    DateTime?
  repeatRule String?
  status     String       @default("pending")
  createdAt  DateTime     @default(now())
}

model Notification {
  id        String       @id @default(uuid())
  org       Organization @relation(fields: [orgId], references: [id])
  orgId     String
  user      User         @relation(fields: [userId], references: [id])
  userId    String
  type      String
  payload   String
  readAt    DateTime?
  createdAt DateTime     @default(now())
}

model Application {
  id             String   @id @default(uuid())
  org            Organization @relation(fields: [orgId], references: [id])
  orgId          String
  startupName    String
  sector         String?
  stage          String?
  pitchDeckUrl   String?
  askAmount      Float?
  source         String?
  status         String?  @default("pending")
  submittedAt    DateTime @default(now())
  founderNames   String
  reviewerIds    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Startup {
  id               String   @id @default(uuid())
  org              Organization @relation(fields: [orgId], references: [id])
  orgId            String
  name             String
  sector           String?
  businessModel    String?
  incorporationDate DateTime?
  status           String?
  responsibleUser  User?    @relation(fields: [responsibleUserId], references: [id])
  responsibleUserId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  kpiCheckIns      KpiCheckIn[]
  cohortEnrollments CohortEnrollment[]
  mentorAssignments MentorAssignment[]
  mentorSessionLogs MentorSessionLog[]
}

model Cohort {
  id          String   @id @default(uuid())
  org         Organization @relation(fields: [orgId], references: [id])
  orgId       String
  name        String
  description String?
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  enrollments CohortEnrollment[]
  curriculum  Curriculum[]
}

model CohortEnrollment {
  id         String   @id @default(uuid())
  cohort     Cohort   @relation(fields: [cohortId], references: [id])
  cohortId   String
  startup    Startup  @relation(fields: [startupId], references: [id])
  startupId  String
  enrolledAt DateTime @default(now())

  @@unique([cohortId, startupId])
}

model Curriculum {
  id          String   @id @default(uuid())
  cohort      Cohort   @relation(fields: [cohortId], references: [id])
  cohortId    String
  weekNumber  Int
  title       String?
  description String?
  createdAt   DateTime @default(now())
}

model KpiCheckIn {
  id          String   @id @default(uuid())
  startup     Startup  @relation(fields: [startupId], references: [id])
  startupId   String
  periodDate  DateTime
  metrics     String
  submittedBy String?
  createdAt   DateTime @default(now())
}

model Mentor {
  id           String   @id @default(uuid())
  user         User     @relation(fields: [userId], references: [id])
  userId       String   @unique
  bio          String?
  expertiseTags String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignments   MentorAssignment[]
  sessionLogs   MentorSessionLog[]
}

model MentorAssignment {
  id        String   @id @default(uuid())
  mentor    Mentor   @relation(fields: [mentorId], references: [id])
  mentorId  String
  startup   Startup  @relation(fields: [startupId], references: [id])
  startupId String
  createdAt DateTime @default(now())

  @@unique([mentorId, startupId])
}

model MentorSessionLog {
  id              String   @id @default(uuid())
  mentor          Mentor   @relation(fields: [mentorId], references: [id])
  mentorId        String
  startup         Startup  @relation(fields: [startupId], references: [id])
  startupId       String
  date            DateTime
  durationMinutes Int?
  notes           String?
  actionItems     String?
  createdAt       DateTime @default(now())
}
